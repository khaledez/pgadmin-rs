# pgAdmin-rs Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env with real passwords!

# ============================================================================
# Server Configuration
# ============================================================================

# Server host and port
# Format: HOST:PORT
# Default: 0.0.0.0:3000
SERVER_ADDRESS=0.0.0.0:3000

# ============================================================================
# Password Protection (optional)
# ============================================================================

# If set, all requests require authentication via a login page.
# Users must enter this password to access the application.
# If not set, the application is accessible without authentication.
# SERVER_PASSWORD=changeme

# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# Maximum requests per minute per IP address
# This helps prevent abuse and DoS attacks
# Default: 100
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================

# PostgreSQL connection URL (required)
# Format: postgres://user:password@host:port/database
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/testdb

# ============================================================================
# Logging Configuration
# ============================================================================

# Rust logging level
# Format: module=level[,module=level,...]
# Levels: trace, debug, info, warn, error
RUST_LOG=pgadmin_rs=debug,axum=info,sqlx=warn
